# ─── Analytics ───────────────────────────────────────────────────────────────
# Privacy-respecting, cookieless analytics — no cookie banner required.
# Both Plausible and Umami are supported; just point to the correct script URL.
#
# Plausible (self-hosted or cloud):
#   PUBLIC_ANALYTICS_URL=https://plausible.io/js/script.js
#   PUBLIC_ANALYTICS_SITE_ID=yournewsdomain.com
#
# Umami (self-hosted):
#   PUBLIC_ANALYTICS_URL=https://umami.yourhost.com/script.js
#   PUBLIC_ANALYTICS_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Leave blank (or omit entirely) to disable analytics in development.
PUBLIC_ANALYTICS_URL=
PUBLIC_ANALYTICS_SITE_ID=

# ─── Ingest Pipeline (scripts/ingest.mjs) ────────────────────────────────────
# Required for daily automated news ingestion via GitHub Actions.
# GEMINI_API_KEY=your-gemini-api-key-here
